# Cổng HTTP của API
PORT=4000
NODE_ENV=development

# Địa chỉ frontend (CORS + link trong email)
CLIENT_URL=http://localhost:5173

# Nhận diện release cho smoke production. Lấy từ npm run validate:identity.
# Để trống trong development; không dùng hash giả khi nghiệm thu.
RELEASE_SHA=
RELEASE_SOURCE_HASH=

# Email: development dùng outbox. Production dùng smtp, hoặc gmail (Gmail API qua HTTPS) khi host chặn cổng SMTP.
# MAIL_MODE=gmail cần GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET, GMAIL_REFRESH_TOKEN, MAIL_FROM (xem docs/DEPLOY_VERCEL.md).
MAIL_MODE=outbox
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
SMTP_USER=
# App Password của Google (không phải mật khẩu đăng nhập). Không commit .env.
SMTP_PASS=
# Ví dụ: TaskFlow <your-account@gmail.com>; mặc định dùng SMTP_USER.
# Gửi từ no-reply@tenmien cần nhà cung cấp email đã xác minh tên miền (vd Resend: smtp.resend.com, SMTP_USER=resend,
# SMTP_PASS=API key). Gmail tự đổi From về chính tài khoản đăng nhập.
MAIL_FROM=
# Chỉ khi sau reverse proxy: điền số proxy phía trước (vd 1) hoặc IP/CIDR tin cậy, ví dụ loopback nếu nginx cùng máy.
# Để trống khi gọi trực tiếp; không tin X-Forwarded-For do client tự gửi.
TRUST_PROXY=

# PostgreSQL. Để trống => tự chạy PostgreSQL nhúng (BackEnd/.data/pg, cổng 54329).
# Ví dụ khi đã triển khai: postgresql://user:matkhau@localhost:5432/taskflow  hoặc chuỗi của Neon/Supabase/RDS
DATABASE_URL=

# Seed demo CHỈ development. Production bắt buộc SEED_DEMO=false.
SEED_DEMO=true

# Bí mật ký JWT – giá trị dưới đây chỉ dùng local; production cần chuỗi ngẫu nhiên >= 32 ký tự.
JWT_SECRET=change-me-dev-only-secret

# Google OAuth Web Client ID (phải trùng VITE_GOOGLE_CLIENT_ID bên FrontEnd)
GOOGLE_CLIENT_ID=

# AIService (thư mục AIService): địa chỉ + khóa dùng chung (phải trùng AI_SERVICE_KEY bên AIService)
# Khóa Anthropic / model AI cấu hình ở AIService/.env
AI_SERVICE_URL=http://localhost:5000
AI_SERVICE_KEY=
AI_TIMEOUT_MS=30000

# Đăng nhập Google (Google Identity Services). Lấy Client ID ở Google Cloud Console > APIs & Services > Credentials.
# FrontEnd/.env cần VITE_GOOGLE_CLIENT_ID cùng giá trị này.
GOOGLE_CLIENT_ID=

# Lưu tệp ở Supabase Storage (bucket private) khi host không có ổ đĩa bền; để trống thì dùng UPLOAD_DIR.
# Khóa service_role/secret có toàn quyền: chỉ đặt ở server.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=taskflow-uploads

# Thư mục lưu tệp tải lên
UPLOAD_DIR=./.data/uploads

# Giới hạn chống spam (mặc định 10 tài khoản/giờ/IP). SECURITY_THROTTLE=false để tắt khi cần.
# Nhiều sinh viên dùng chung Wi-Fi trường thì tăng REGISTER_PER_IP_PER_HOUR khi cả lớp đăng ký cùng lúc.
REGISTER_PER_IP_PER_HOUR=10
