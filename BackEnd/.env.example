# Cổng HTTP của API
PORT=4000
NODE_ENV=development

# Địa chỉ frontend (CORS + link trong email)
CLIENT_URL=http://localhost:5173

# PostgreSQL. Để trống => tự chạy PostgreSQL nhúng (dữ liệu lưu ở server/.data/pg, cổng 54329)
# Ví dụ khi đã triển khai: postgresql://user:matkhau@localhost:5432/taskflow  hoặc chuỗi của Neon/Supabase/RDS
DATABASE_URL=

# Seed dữ liệu demo Nhóm 24 khi DB trống (true/false)
SEED_DEMO=true

# Bí mật ký JWT – BẮT BUỘC đổi khi triển khai thật
JWT_SECRET=change-me-dev-only-secret

# AIService (thư mục AIService): địa chỉ + khóa dùng chung (phải trùng AI_SERVICE_KEY bên AIService)
# Khóa Anthropic / model AI cấu hình ở AIService/.env
AI_SERVICE_URL=http://localhost:5000
AI_SERVICE_KEY=
AI_TIMEOUT_MS=30000

# Thư mục lưu tệp tải lên
UPLOAD_DIR=./.data/uploads
