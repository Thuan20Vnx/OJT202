# Cổng HTTP của AIService (BackEnd gọi tới qua AI_SERVICE_URL)
PORT=5000
NODE_ENV=development

# Khóa dùng chung với BackEnd (header x-ai-service-key). BẮT BUỘC đặt khi triển khai, phải trùng với BackEnd.
AI_SERVICE_KEY=

# AI: để trống => dùng bộ AI nội bộ (quy tắc, không gọi mạng)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Nhà cung cấp dự phòng (tùy chọn): khi nhà cung cấp trước lỗi hoặc hết hạn mức, AIService tự chuyển sang cái kế.
# Lưu ý: nội dung công việc/tài liệu sẽ được gửi tới mọi nhà cung cấp có khóa ở đây.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Model chạy trên máy bằng Ollama: đặt tên model để bật (ví dụ qwen3:8b). Không cần khóa, không giới hạn lượt.
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434/v1
# Thứ tự thử và thời gian chờ mỗi nhà cung cấp trước khi chuyển (mili giây)
AI_PROVIDER_ORDER=gemini,groq,openrouter,ollama
AI_PROVIDER_TIMEOUT_MS=12000
