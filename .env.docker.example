# Mẫu cho docker compose. Chép thành .env.docker (đã nằm trong .gitignore) rồi điền giá trị thật.
POSTGRES_PASSWORD=
# Ít nhất 32 ký tự ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
AI_SERVICE_KEY=
CLIENT_URL=http://localhost:4000
# Production không cho MAIL_MODE=outbox: dùng smtp (SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, MAIL_FROM) hoặc gmail (GMAIL_*).
MAIL_MODE=smtp
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Để trống thì AIService dùng bộ luật nội bộ.
GEMINI_API_KEY=
